{
  "openapi": "3.0.1",
  "info": {
    "title": "EngageLab OTP API - OTP Delivery",
    "description": "Generate verification codes through the EngageLab platform and deliver them according to the channel strategy specified in the template. If you want to generate verification codes yourself instead of using the EngageLab platform, you can call the Custom OTP Code Delivery API.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://otp.api.engagelab.cc"
    }
  ],
  "paths": {
    "/v1/messages": {
      "post": {
        "summary": "OTP Delivery",
        "description": "Generate and send OTP codes to users.",
        "security": [
          {
            "BasicAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "to",
                  "template"
                ],
                "properties": {
                  "to": {
                    "type": "string",
                    "description": "Target recipient: phone number or email address, for example, +6598765432 or support@engagelab.com"
                  },
                  "template": {
                    "type": "object",
                    "required": [
                      "id"
                    ],
                    "description": "Template information.",
                    "properties": {
                      "id": {
                        "type": "string",
                        "description": "Template ID"
                      },
                      "language": {
                        "type": "string",
                        "description": "Template language. Supported languages: default, zh_CN, zh_HK, en, ja, th, es. If not provided, the default value is 'default'.",
                        "default": "default"
                      },
                      "params": {
                        "type": "object",
                        "description": "Values for custom template variable keys. If you defined custom variables when creating the template, assign values to them here. For example, if the template content is 'Hi {{name}}, your verify code is {{code}}', then the assignment parameter 'params':{'name':'Bob'} is required.",
                        "additionalProperties": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "message_id",
                    "send_channel"
                  ],
                  "properties": {
                    "message_id": {
                      "type": "string",
                      "description": "Message ID, which uniquely identifies a message"
                    },
                    "send_channel": {
                      "type": "string",
                      "description": "Indicates the current delivery channel. Possible values are whatsapp, sms, email, or voice."
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BasicAuth": {
        "type": "http",
        "scheme": "basic",
        "description": "Use HTTP Basic Authentication for authentication. The generation algorithm for `base64_auth_string` is: `base64(dev_key:dev_secret)`"
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "description": "Error code. For example: 3001, 5001, etc."
          },
          "message": {
            "type": "string",
            "description": "Error details"
          }
        }
      }
    }
  }
}