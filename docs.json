          },
          {
            "group": "Ways to Use",
            "pages": []
          },
          {
            "group": "REST API",
            "pages": [
              "otp/api/authentication",
              "otp/api/custom-message-delivery.json POST /v1/custom-messages",
              "otp/api/custom-otp-code-delivery.json POST /v1/codes",
