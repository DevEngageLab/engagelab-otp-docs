{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "EngageLab Docs",
  "description": "The official documentation for EngageLab.",
  "metadata": {
    "timestamp": true
  },
  "seo": {
    "indexing": "all",
    "metatags": {
      "og:type": "website",
      "og:site_name": "EngageLab Documentation",
      "canonical": "https://www.engagelab.com/"
    }
  },
  "colors": {
    "primary": "#5E6BFA",
    "light": "#6A76FF",
    "dark": "#5E6BFA"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "OTP",
        "groups": [
          {
            "group": "Getting started",
            "pages": [
              "otp/getting-started/index",
              "otp/getting-started/overview",
              "otp/getting-started/quickstart"
            ]
          },
          {
            "group": "Ways to Use",
            "pages": [
              "otp/ways-to-use/rest-api",
              "otp/ways-to-use/skill",
              "otp/ways-to-use/sdk"
            ]
          },
          {
            "group": "OTP Service",
            "pages": [
              "otp/api/authentication",
              "otp/api/custom-message-delivery.json POST /v1/custom-messages",
              "otp/api/custom-otp-code-delivery.json POST /v1/codes",
              "otp/api/otp-delivery.json POST /v1/messages",
              "otp/api/otp-verification.json POST /v1/verifications",
              "otp/api/template.json POST /v1/template-configs",
              "otp/api/template.json GET /v1/template-configs",
              "otp/api/template.json GET /v1/template-configs/{templateId}",
              "otp/api/template.json DELETE /v1/template-configs/{templateId}"
            ]
          },
          {
            "group": "Else",
            "pages": [
              "otp/api/smpp",
              "otp/api/callback"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Learning Center",
          "href": "https://www.engagelab.com/learning-center",
          "icon": "graduation-cap"
        },
        {
          "anchor": "Customer Cases",
          "href": "https://www.engagelab.com/customer-cases",
          "icon": "briefcase"
        },
        {
          "anchor": "Blog",
          "href": "https://www.engagelab.com/blog",
          "icon": "newspaper"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Home",
        "href": "https://www.engagelab.com/"
      },
      {
        "label": "Support",
        "href": "mailto:support@aurora-mobile.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Console",
      "href": "https://www.engagelab.com/console/"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "grok",
      "aistudio",
      "devin",
      "windsurf",
      "cursor",
      "vscode",
      "mcp",
      "add-mcp"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://twitter.com/EngageLab_",
      "facebook": "https://facebook.com/EngageLab.Aurora.Mobile",
      "linkedin": "https://linkedin.com/company/engagelab-aurora-mobile",
      "youtube": "https://www.youtube.com/@EngageLab_"
    },
    "links": [
      {
        "header": "Policy",
        "items": [
          {
            "label": "Service Agreement",
            "href": "https://www.engagelab.com/license/service-policy"
          },
          {
            "label": "Privacy Policy",
            "href": "https://www.engagelab.com/license/privacy"
          }
        ]
      }
    ]
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "icons": {
    "library": "lucide"
  },
  "api": {
    "playground": {
      "display": "interactive"
    },
    "examples": {
      "languages": [
        "bash",
        "javascript",
        "python",
        "go",
        "java",
        "node",
        "php",
        "ruby",
        "swift",
        "powershell"
      ],
      "defaults": "required",
      "prefill": true
    }
  }
}